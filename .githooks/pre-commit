#!/bin/sh
# Pre-commit check: format check + lint (no tests, so commits stay fast).
# Enable once per clone: git config core.hooksPath .githooks
# Skip once in an emergency: git commit --no-verify

# GUI git clients do not inherit your shell PATH; add Homebrew's locations.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! command -v swiftlint >/dev/null 2>&1; then
    echo "pre-commit: swiftlint is not installed. Run: brew install swiftlint" >&2
    exit 1
fi

echo "pre-commit: swift format lint"
if ! swift format lint --strict --recursive App Packages/LangTeacherKit/Sources Packages/LangTeacherKit/Tests; then
    echo "pre-commit: formatting issues. Fix with:" >&2
    echo "  swift format --in-place --recursive App Packages/LangTeacherKit/Sources Packages/LangTeacherKit/Tests" >&2
    exit 1
fi

echo "pre-commit: swiftlint"
if ! swiftlint lint --strict --quiet; then
    echo "pre-commit: lint issues (see above)." >&2
    exit 1
fi
